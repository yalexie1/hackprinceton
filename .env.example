# Copy to .env and fill in. .env is git-ignored; this repo is public, so never commit real values.
# Values come from /costar-keys in the CoStar track Discord (run it again any time to see them).

COSTAR_ZIP_PASSWORD=
# The kit link is signed and expires about 24 h after it is issued. Download the zip once,
# keep it outside the repo or under data/cache/, and set COSTAR_KIT_ZIP to its path.
COSTAR_KIT_URL=
COSTAR_KIT_ZIP=

# Default key set (your own).
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=

# Optional extra key sets from teammates, for spreading bulk harvesting across keys.
# Same names with a suffix: _B, _C, _D.
# MATTERPORT_API_KEY_B=
# MATTERPORT_API_TOKEN_B=
# MATTERPORT_SDK_KEY_B=
# VEXCEL_API_KEY_B=

ANTHROPIC_API_KEY=
